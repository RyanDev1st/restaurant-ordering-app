{"schema_version": 1, "diagram_type": "sequence", "meta": {"title": "Placing an order, step by step", "subtitle": "Read top to bottom. Every click in the app follows this same path.", "quality_profile": "showcase", "column_fit": "spread", "viewBox": [1040, 620]}, "participants": [{"id": "customer", "type": "external", "label": "Customer"}, {"id": "ui", "type": "frontend", "label": "Menu window", "sublabel": "MenuFrame · Student 1"}, {"id": "service", "type": "backend", "label": "OrderService", "sublabel": "rules · Student 2"}, {"id": "dao", "type": "backend", "label": "OrderDatabase", "sublabel": "SQL · Student 3"}, {"id": "db", "type": "database", "label": "restaurant.db", "sublabel": "saved data"}, {"id": "staff", "type": "external", "label": "Staff"}, {"id": "staffui", "type": "frontend", "label": "Staff window", "sublabel": "StaffOrdersFrame"}], "messages": [{"from": "customer", "to": "ui", "y": 160, "label": "1. picks food, clicks Place order"}, {"from": "ui", "to": "service", "y": 188, "label": "2. placeOrder(customer, table, cart)", "variant": "emphasis"}, {"from": "service", "to": "dao", "y": 216, "label": "3. rules OK, save this order", "variant": "emphasis"}, {"from": "dao", "to": "db", "y": 244, "label": "4. INSERT order + items (all or nothing)"}, {"from": "dao", "to": "service", "y": 272, "label": "saved, new order number", "variant": "return"}, {"from": "service", "to": "ui", "y": 300, "label": "Order object", "variant": "return"}, {"from": "ui", "to": "customer", "y": 328, "label": "5. shows: Order 12 is PENDING", "variant": "emphasis"}, {"from": "service", "to": "ui", "y": 365, "label": "IF A RULE FAILS: empty cart or sold out → ValidationException"}, {"from": "ui", "to": "customer", "y": 393, "label": "shows the error in a message box", "variant": "return"}, {"from": "staff", "to": "staffui", "y": 430, "label": "LATER: staff clicks Next status"}, {"from": "staffui", "to": "service", "y": 458, "label": "advanceStatus(orderId)", "variant": "emphasis"}